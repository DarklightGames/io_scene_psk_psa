{
    // `.venv/` is the uv-managed default environment: the newest supported
    // Blender version (`bpy`) with the Python it requires. It's created and kept
    // up to date by the "uv sync" task, which runs when the folder is opened.
    // Don't use VS Code's "Create Environment" command: it ignores uv.lock and
    // the dependency groups in pyproject.toml.
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": ["tests"],

    // Format Python with Ruff (configured in pyproject.toml), using the version
    // installed in `.venv/` so it matches `uv run ruff format`.
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true
    },
    "ruff.importStrategy": "fromEnvironment"
}
